#!/bin/bash

set -u

INTERVAL="${INTERVAL:-10}"
IOSTAT_EVERY="${IOSTAT_EVERY:-60}"
KEEP_DAYS="${KEEP_DAYS:-7}"

LOGDIR="${LOGDIR:-/var/log/dmz-v2-max4}"

mkdir -p "$LOGDIR"

MAX_R=0
MAX_C=0
MAX_K=0

LAST_IOSTAT=0
LAST_DAY=""

trap 'exit 0' TERM INT


get_vm_state()
{
    qm status 100 2>/dev/null |
    tr '\n' ' ' ||
    true
}


while true; do

    DAY="$(date '+%Y%m%d')"
    NOW="$(date '+%F %T.%3N')"
    EPOCH="$(date +%s)"

    MONLOG="$LOGDIR/monitor-${DAY}.log"
    IOLOG="$LOGDIR/iostat-${DAY}.log"

    #
    # 每天做一次日志清理
    #
    if [ "$DAY" != "$LAST_DAY" ]; then

        echo "===== NEW DAY $DAY =====" >>"$MONLOG"

        find "$LOGDIR" \
            -type f \
            \( -name '*.log' -o -name '*.log.gz' \) \
            -mtime "+${KEEP_DAYS}" \
            -delete \
            2>/dev/null || true

        #
        # 压缩一天以上的旧日志
        #
        find "$LOGDIR" \
            -type f \
            -name '*.log' \
            -mtime +0 \
            -exec gzip -f {} \; \
            2>/dev/null || true

        LAST_DAY="$DAY"
    fi


    #
    # D-state reclaim
    #
    R="$(
        ps -eo stat=,wchan:64=,comm=,args= 2>/dev/null |
        awk '
        $1 ~ /^D/ &&
        $2 ~ /dmz_reclaim_copy/
        {
            n++
        }
        END {
            print n+0
        }'
    )"


    #
    # chunk mapping wait
    #
    C="$(
        ps -eo stat=,wchan:64=,comm=,args= 2>/dev/null |
        awk '
        $1 ~ /^D/ &&
        $2 ~ /dmz_get_chunk_mapping/
        {
            n++
        }
        END {
            print n+0
        }'
    )"


    #
    # kcopyd:
    # 有些线程 wchan 是 msleep，
    # 所以同时检查整行是否出现 kcopyd
    #
    K="$(
        ps -eo stat=,wchan:64=,comm=,args= 2>/dev/null |
        awk '
        $1 ~ /^D/ &&
        $0 ~ /kcopyd/
        {
            n++
        }
        END {
            print n+0
        }'
    )"


    [ "$R" -gt "$MAX_R" ] && MAX_R="$R"
    [ "$C" -gt "$MAX_C" ] && MAX_C="$C"
    [ "$K" -gt "$MAX_K" ] && MAX_K="$K"


    {
        echo
        echo "############################################################"
        echo "TIME $NOW"
        echo "############################################################"

        echo \
        "reclaimD=$R chunkD=$C kcopyD=$K maxR=$MAX_R maxC=$MAX_C maxK=$MAX_K"

        echo "load=$(cat /proc/loadavg)"

        echo "vm100=$(get_vm_state)"


        echo
        echo "PARAMS:"

        P="/sys/module/dm_zoned/parameters"

        if [ -d "$P" ]; then

            for X in \
                reclaim_start \
                reclaim_stop \
                reclaim_idle_sec \
                reclaim_idle_throttle \
                reclaim_poll_sec \
                reclaim_max_active \
                reclaim_slot_retry_ms \
                reclaim_yield_ms
            do

                if [ -r "$P/$X" ]; then
                    printf "%s=%s " \
                        "$X" \
                        "$(cat "$P/$X")"
                fi

            done

            echo

        else
            echo "dm_zoned module parameters unavailable"
        fi


        echo
        echo "DMSETUP:"

        for M in $(
            dmsetup ls --target zoned 2>/dev/null |
            awk '{print $1}' |
            grep '^dmz_D' |
            sort
        ); do

            printf "%-28s " "$M"
            dmsetup status "$M" 2>/dev/null || true

        done


        echo
        echo "D-STATE:"

        ps -eo \
            pid,ppid,stat,pcpu,wchan:55,comm,args \
            2>/dev/null |
        awk '
        $3 ~ /^D/ &&
        (
            $5 ~ /dmz_reclaim_copy/ ||
            $5 ~ /dmz_get_chunk_mapping/ ||
            $0 ~ /kcopyd/
        )
        {
            print
        }' ||
        true

    } >>"$MONLOG" 2>&1


    #
    # 每60秒记录一次完整 iostat
    #
    if [ $((EPOCH - LAST_IOSTAT)) -ge "$IOSTAT_EVERY" ]; then

        {
            echo
            echo "############################################################"
            echo "TIME $(date '+%F %T.%3N')"
            echo "############################################################"

            iostat -xmd 1 2

        } >>"$IOLOG" 2>&1 || true

        LAST_IOSTAT="$EPOCH"
    fi


    sleep "$INTERVAL"

done
